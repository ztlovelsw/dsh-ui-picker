{
  "name": "dsh-ui-picker",
  "version": "0.3.0",
  "description": "点选或批注前端页面：点一下控件拿到选择器/样式，或在页面上钉编号标记逐条写批注，发送后在 DeepSeek Harness 输入框上方以「N 条注释」逐条校对，再交给 AI。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./picker.js": "./picker.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "picker.js",
    "dsh-ui-picker.user.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.en.md",
    "preview-annotation.png",
    "preview-comments.png",
    "preview-fab.png"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ui-picker",
    "element-picker",
    "element-inspector",
    "frontend",
    "css-selector",
    "xpath",
    "react",
    "vue",
    "llm",
    "ai",
    "deepseek",
    "devtools",
    "dom-inspector",
    "ui-inspector",
    "code-agent",
    "web-development",
    "annotation",
    "page-annotation",
    "visual-feedback",
    "comment",
    "markup",
    "feedback",
    "composer-chip",
    "annotation-chip",
    "inline-comments"
  ],
  "license": "MIT",
  "author": "ztlovelsw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ztlovelsw/dsh-ui-picker.git"
  },
  "homepage": "https://github.com/ztlovelsw/dsh-ui-picker#readme",
  "bugs": {
    "url": "https://github.com/ztlovelsw/dsh-ui-picker/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node scripts/sync-userscript.mjs --check && node tests/bridge-test.mjs && node tests/client-test.mjs && node tests/client-dup-test.mjs",
    "sync:user": "node scripts/sync-userscript.mjs",
    "install:dsh": "node install.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "id": "dsh-ui-picker",
    "name": "UI 拾取器",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
